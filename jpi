#!/bin/bash
# Set terminal title before and during execution (stderr: stdout must stay
# clean for print/rpc modes)
printf '\033]0;J-PI\007' >&2

# Prevent zsh precmd/preexec from overriding the title
export DISABLE_AUTO_TITLE="true"

# Resolve symlinks to get the real script location
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Use the resolved directory
export JPI_SRC="$SCRIPT_DIR/src"

# Machine-local overrides (NOT tracked by git): local/env.sh may export
# JBIN (path to J's jconsole) and JPI_JCORE (path to the J-CORE manual).
# See local/env.example.
if [ -f "$SCRIPT_DIR/local/env.sh" ]; then
    . "$SCRIPT_DIR/local/env.sh"
fi

# Find jconsole — validate that it is J's jconsole, not Java's.
# Java's jconsole is a GUI app; J's jconsole evaluates J expressions.
# Validation: echo 'i. 3' | jconsole should print "0 1 2".
# ijconsole is searched first. Many J installs use that name so the
# binary does not collide with Java's jconsole.
is_j_jconsole() {
    echo 'i. 3' | perl -e 'alarm 10; exec @ARGV' "$1" 2>/dev/null | grep -q '^0 1 2'
}

for candidate in \
    "${JBIN:-}" \
    "$HOME/j9.8/bin/ijconsole" \
    "$HOME/j9.8/bin/jconsole" \
    "/Applications/j9.8/bin/ijconsole" \
    "/Applications/j9.8/bin/jconsole" \
    "/usr/local/bin/ijconsole" \
    "/usr/local/j9.8/bin/ijconsole" \
    "/usr/local/j9.8/bin/jconsole" \
    "$(command -v ijconsole 2>/dev/null)" \
    "$SCRIPT_DIR/local/ijconsole" \
    "$SCRIPT_DIR/local/jconsole" \
    "/usr/local/bin/jconsole" \
    "$(command -v jconsole 2>/dev/null)"
do
    if [ -n "$candidate" ] && [ -x "$candidate" ] && is_j_jconsole "$candidate"; then
        JBIN="$candidate"
        break
    fi
done

if [ -z "$JBIN" ]; then
    echo "Error: J's jconsole not found. Please install J or set JBIN to the J jconsole path."
    echo "Note: /usr/bin/jconsole on Linux is Java's jconsole (a GUI app), not J's."
    exit 1
fi

# A hit on local/jconsole may itself be the symlink we are about to
# refresh. Follow it out of local/ so the new link does not point at
# itself and drop the real binary.
_hops=0
while [ -L "$JBIN" ] && [ "$_hops" -lt 5 ]; do
    case "$JBIN" in
        "$SCRIPT_DIR/local/"*) ;;
        *) break ;;
    esac
    _t="$(readlink "$JBIN")"
    case "$_t" in
        /*) _next="$_t" ;;
        *) _next="$SCRIPT_DIR/local/$_t" ;;
    esac
    [ "$_next" = "$JBIN" ] && break
    JBIN="$_next"
    _hops=$((_hops + 1))
done
if [ "$_hops" -gt 0 ] && ! is_j_jconsole "$JBIN"; then
    echo "Error: $JBIN is not J's jconsole." >&2
    exit 1
fi

export JBIN
echo "jpi: using J jconsole at $JBIN" >&2

# Machine-local names for tool shells. Both point at the binary just
# found. A real file at that path is left alone. An existing symlink
# is replaced only when it points somewhere else.
case "$JBIN" in
    "$SCRIPT_DIR/local/"*)
        echo "jpi: not linking local/ to itself" >&2
        ;;
    *)
        mkdir -p "$SCRIPT_DIR/local"
        for link_name in jconsole ijconsole; do
            link_path="$SCRIPT_DIR/local/$link_name"
            if [ -L "$link_path" ]; then
                if [ "$(readlink "$link_path")" = "$JBIN" ]; then
                    continue
                fi
            elif [ -e "$link_path" ]; then
                echo "jpi: $link_path exists and is not a symlink; leaving it" >&2
                continue
            fi
            ln -sfn "$JBIN" "$link_path"
            echo "jpi: linked $link_path -> $JBIN" >&2
        done
        ;;
esac

# Flags before the mode. --tools, --session, --session-id, --fork,
# and --name take the next argument. Session selectors exclude
# each other. --fork may be combined with --session-id and --name.
session_reject() {
    echo "jpi: $1 cannot be combined with $2" >&2
    exit 2
}

set_session_mode() {
    flag=$1
    mode=$2
    if [ -n "${JPI_FORK_FROM:-}" ] && [ "$mode" != "session-id" ]; then
        session_reject "$flag" "--fork"
    fi
    if [ -n "${JPI_SESSION_MODE:-}" ] && [ "$JPI_SESSION_MODE" != "$mode" ]; then
        session_reject "$flag" "the other session flag"
    fi
    export JPI_SESSION_MODE="$mode"
}

need_flag_value() {
    if [ $# -lt 2 ] || [ -z "$2" ]; then
        echo "jpi: $1 needs a value" >&2
        exit 2
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --continue)
            set_session_mode "--continue" continue
            shift
            ;;
        --resume)
            set_session_mode "--resume" resume
            shift
            ;;
        --no-session)
            set_session_mode "--no-session" none
            shift
            ;;
        --session)
            need_flag_value "$@"
            set_session_mode "--session" session
            export JPI_SESSION_ARG="$2"
            shift 2
            ;;
        --session=*)
            set_session_mode "--session" session
            export JPI_SESSION_ARG="${1#--session=}"
            if [ -z "$JPI_SESSION_ARG" ]; then
                echo "jpi: --session needs a value" >&2
                exit 2
            fi
            shift
            ;;
        --session-id)
            need_flag_value "$@"
            set_session_mode "--session-id" session-id
            export JPI_SESSION_ID="$2"
            shift 2
            ;;
        --session-id=*)
            set_session_mode "--session-id" session-id
            export JPI_SESSION_ID="${1#--session-id=}"
            if [ -z "$JPI_SESSION_ID" ]; then
                echo "jpi: --session-id needs a value" >&2
                exit 2
            fi
            shift
            ;;
        --fork)
            need_flag_value "$@"
            case "${JPI_SESSION_MODE:-}" in
                continue|resume|session|none)
                    session_reject "--fork" "--${JPI_SESSION_MODE}"
                    ;;
            esac
            if [ -n "${JPI_FORK_FROM:-}" ]; then
                echo "jpi: --fork given twice" >&2
                exit 2
            fi
            export JPI_FORK_FROM="$2"
            shift 2
            ;;
        --fork=*)
            case "${JPI_SESSION_MODE:-}" in
                continue|resume|session|none)
                    session_reject "--fork" "--${JPI_SESSION_MODE}"
                    ;;
            esac
            if [ -n "${JPI_FORK_FROM:-}" ]; then
                echo "jpi: --fork given twice" >&2
                exit 2
            fi
            export JPI_FORK_FROM="${1#--fork=}"
            if [ -z "$JPI_FORK_FROM" ]; then
                echo "jpi: --fork needs a value" >&2
                exit 2
            fi
            shift
            ;;
        -n|--name)
            need_flag_value "$@"
            export JPI_SESSION_LABEL="$2"
            shift 2
            ;;
        --name=*)
            export JPI_SESSION_LABEL="${1#--name=}"
            if [ -z "$JPI_SESSION_LABEL" ]; then
                echo "jpi: --name needs a value" >&2
                exit 2
            fi
            shift
            ;;
        --no-mcp)
            export JPI_NO_MCP=1
            shift
            ;;
        --tools)
            if [ $# -lt 2 ]; then
                echo "jpi: --tools needs a comma-separated list" >&2
                exit 2
            fi
            export JPI_TOOLS="$2"
            shift 2
            ;;
        --tools=*)
            export JPI_TOOLS="${1#--tools=}"
            shift
            ;;
        *)
            break
            ;;
    esac
done

case "${1:-}" in
    -p|--print|rpc|--rpc|serve|--serve)
        if [ "${JPI_SESSION_MODE:-}" = resume ]; then
            echo "jpi: --resume is only for the interactive session" >&2
            exit 2
        fi
        ;;
esac

# Mode dispatch: default is the interactive TUI.
# The title restore below would otherwise hide the child's status.
jpi_status=0
case "${1:-}" in
    -p|--print)
        shift
        "$JBIN" "$JPI_SRC/pi_print.ijs" "$@"
        jpi_status=$?
        ;;
    rpc|--rpc)
        "$JBIN" "$JPI_SRC/pi_rpc.ijs"
        jpi_status=$?
        ;;
    mcp)
        shift
        "$JBIN" "$JPI_SRC/pi_mcp.ijs" "$@"
        jpi_status=$?
        ;;
    serve|--serve)
        "$JBIN" "$JPI_SRC/pi_serve.ijs"
        jpi_status=$?
        ;;
    -h|--help)
        cat <<'USAGE'
jpi                    interactive TUI (default)
jpi -p PROMPT          one-shot: run PROMPT through the agent, print reply
jpi rpc                batch JSONL RPC: commands on stdin, events on stdout
                       (see pi_rpc.ijs header for the protocol)
jpi serve              service mode: same JSONL protocol over a localhost
                       TCP socket (default port 8765, JPI_SERVE_PORT to
                       change). Clients attach/detach; the session lives on.
                       See pi_serve.ijs header.

Flags come before the mode:
  --continue           reopen the newest session for this directory
  --resume             pick a session from the list (interactive)
  --session PATH|ID    open that session file or a unique name
  --session-id ID      open or create that exact session name
  --fork PATH|ID       copy that session into a new file
  --no-session         keep the conversation in memory
  -n, --name LABEL     set the session display name
  --no-mcp             do not send MCP tools to the model
  --tools LIST         comma list of tools. +name/-name edits the
                       default set; a trailing * is a prefix.
  mcp list|add|remove  manage ~/.jpi/mcp.json (see: jpi mcp)
USAGE
        ;;
    *)
        "$JBIN" "$JPI_SRC/tui_run.ijs"
        jpi_status=$?
        ;;
esac

# Restore title on exit
printf '\033]0;%s\007' "${SHELL##*/}" >&2
exit "$jpi_status"
