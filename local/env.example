# Machine-local jpi overrides - copy this file to local/env.sh
# (untracked by git; sourced by the jpi launcher).
#
# J's jconsole path (the launcher validates it is J's, not Java's;
# common locations, including ijconsole, are searched if unset):
# export JBIN=/path/to/jconsole
#
# On startup JPI also ensures local/jconsole and local/ijconsole
# are symlinks to that binary. Both names are gitignored.
#
# J-CORE manual path (referenced in the system prompt and by the j
# tool's escalation ladder). Unset = manual features degrade cleanly.
# export JPI_JCORE=/path/to/J-CORE.md
